# Copy to deploy/compose/.env to override the local defaults. .env is git-ignored; never commit real secrets.
NOISECUT_PROFILE=naive
NOISECUT_TIMESCALE=10
NOISECUT_ORDERS_PER_SIM_MINUTE=300
NOISECUT_SEED=42
NOISECUT_PG_PORT=5432
NOISECUT_PG_PASSWORD=noisecut
NOISECUT_WEBHOOK_SECRET=local-dev-webhook-secret
NOISECUT_ADMIN_KEY=local-dev-admin-key
